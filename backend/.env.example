# Copy to .env for local (non-Docker) runs. Inside docker-compose these are
# already injected via the `environment:` block in docker-compose.yml.

PORT=4000

# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=trusttrail
PGPASSWORD=trusttrail_dev_password
PGDATABASE=trusttrail

# Redis
# utils/redis.ts uses Upstash's REST client (same one the production
# Vercel+Upstash Marketplace integration uses), not plain Redis over TCP --
# REDIS_URL below is unused by the app itself. For a local (non-Docker) run
# against a real Redis, put Upstash's local REST proxy in front of it:
#   docker run -p 8079:80 -e SRH_MODE=env -e SRH_TOKEN=local_dev_token \
#     -e SRH_CONNECTION_STRING=redis://host.docker.internal:6379 hiett/serverless-redis-http
# then point KV_REST_API_URL at it. docker-compose.yml already wires this up
# automatically via its `redis-http` service -- these two only matter here.
REDIS_URL=redis://localhost:6379
KV_REST_API_URL=http://localhost:8079
KV_REST_API_TOKEN=local_dev_token

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ML service (optional — Parth's Flask service, not built by this scaffold).
# Leave unset and the backend simply skips anomaly scoring: disbursements are
# created normally with status flowing pending_bill -> pending_review -> verified,
# just with no anomaly_flags row attached. Set this once /ml/flag exists:
# ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_URL=

CORS_ORIGIN=http://localhost:5007
