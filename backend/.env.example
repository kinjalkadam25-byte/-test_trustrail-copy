# Copy to .env for local (non-Docker) runs. Inside docker-compose these are
# already injected via the `environment:` block in docker-compose.yml.

PORT=4000

# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=trusttrail
PGPASSWORD=trusttrail_dev_password
PGDATABASE=trusttrail

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ML service (optional — Parth's Flask service, not built by this scaffold).
# Leave unset and the backend simply skips anomaly scoring: disbursements are
# created normally with status flowing pending_bill -> pending_review -> verified,
# just with no anomaly_flags row attached. Set this once /ml/flag exists:
# ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_URL=

CORS_ORIGIN=http://localhost:5007
