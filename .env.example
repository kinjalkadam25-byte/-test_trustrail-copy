# docker-compose.yml already injects all of these directly into the backend
# and frontend services — you do NOT need this file to run `docker-compose up`.
#
# It's here for running backend/ or frontend/ locally without Docker: copy
# backend/.env.example -> backend/.env and frontend/.env.local.example ->
# frontend/.env.local, and adjust hosts from container names (db, redis) to
# localhost.

# --- shared reference ---
POSTGRES_USER=trusttrail
POSTGRES_PASSWORD=trusttrail_dev_password
POSTGRES_DB=trusttrail
JWT_SECRET=change_this_to_a_long_random_string
